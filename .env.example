POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragdb

# Set ENVIRONMENT=production for production deployments (enforces >=32 char JWT secret)
ENVIRONMENT=development

# Get a key at https://aistudio.google.com
GEMINI_API_KEY=your-gemini-key-here

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS origins (comma-separated). Add production domain in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:80,http://localhost:5173

# Optional: Override backend startup command (e.g. append --reload for local development)
# BACKEND_COMMAND=uvicorn app.main:app --host 0.0.0.0 --port 8000

# RAG settings (defaults shown — override as needed)
# GENERATION_MODEL=gemini-2.0-flash
# RETRIEVAL_TOP_K=5
# RETRIEVAL_SCORE_THRESHOLD=0.25
# MAX_CONTEXT_CHARS=8000
# MAX_HISTORY_MESSAGES=10
